# JPE Studio Editor - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# AI Services (Optional - for AI features)
# ===========================================

# Anthropic Claude API Key
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key (optional)
# OPENAI_API_KEY=sk-...

# Google Gemini API Key (optional)
# GEMINI_API_KEY=...

# Alibaba Qwen/DashScope API Key (optional)
# DASHSCOPE_API_KEY=...

# ===========================================
# Application Settings
# ===========================================

# Transformation backend mode
# Options: 'python' (default) or 'typescript'
# - python: Uses Python backend via /api/transform
# - typescript: Uses Gemini's TypeScript engine (if available)
NEXT_PUBLIC_TRANSFORM_MODE=python

# Application name and version
NEXT_PUBLIC_APP_NAME="JPE Studio Editor"
NEXT_PUBLIC_APP_VERSION="0.2.0"

# ===========================================
# Feature Flags (Optional)
# ===========================================

# Enable AI features (default: true)
# NEXT_PUBLIC_ENABLE_AI=true

# Enable cloud sync (default: false)
# NEXT_PUBLIC_ENABLE_CLOUD_SYNC=false

# Enable telemetry (default: false)
# NEXT_PUBLIC_ENABLE_TELEMETRY=false

# ===========================================
# Development Settings
# ===========================================

# Enable debug logging
# NEXT_PUBLIC_DEBUG=true

# API base URL (for cloud features)
# NEXT_PUBLIC_API_URL=https://api.jpe-sims4.com
