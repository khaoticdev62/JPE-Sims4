+      const result = JSON.parse(response.data.candidates[0].content.parts[0].text)
+      return { 
+        success: true, 
+        fixedCode: result.fixedCode, 
+        explanation: result.explanation, 
+        cached: false, 
+        timestamp: Date.now() 
