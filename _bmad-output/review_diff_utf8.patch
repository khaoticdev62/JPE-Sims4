+    } catch (error: unknown) {
+      const message = axios.isAxiosError(error) ? error.response?.data?.error?.message : 'API call failed'
+      return { 
+        success: false, 
+        error: message || 'API call failed', 
+        cached: false, 
+        timestamp: Date.now() 
+      }
+    }
+  }
+
