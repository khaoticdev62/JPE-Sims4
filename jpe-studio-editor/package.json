{
  "name": "jpe-studio-editor",
  "version": "1.0.0",
  "description": "A JPE-specific code editor for Sims 4 mod development",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "jpe",
    "sims4",
    "modding",
    "editor",
    "code-editor"
  ],
  "author": "JPE Sims 4 Mod Translation Suite",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/monaco-editor": "^0.40.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0",
    "ts-loader": "^9.3.1",
    "typescript": "^4.8.0",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "monaco-editor": "^0.40.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "monaco-editor-webpack-plugin": "^7.1.0"
  },
  "build": {
    "appId": "com.jpe.studio.editor",
    "productName": "JPE Studio Editor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons"
    }
  }
}