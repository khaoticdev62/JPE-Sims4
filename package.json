{
  "name": "jpe-studio-editor",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "jpe": "dist/cli/jpe-cli.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --no-lint",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=\"integration\" --testEnvironment=node",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:python": "cd tests/python && pytest -v --tb=short",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "validate:roundtrip": "npx tsx src/cli/validate-roundtrip.ts",
    "test:fixtures": "npx tsx test-fixtures/run-tests.ts",
    "test:decompile": "npx tsx src/cli/decompile-service.ts",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development npx electron .\"",
    "electron:build": "npm run build && tsc -p tsconfig.electron.json",
    "electron:start": "npm run electron:build && npx electron .",
    "electron:dist": "npm run electron:build && electron-builder --config electron-builder.yml",
    "electron:dist:win": "npm run electron:build && electron-builder --win --config electron-builder.yml",
    "electron:dist:mac": "npm run electron:build && electron-builder --mac --config electron-builder.yml",
    "electron:dist:linux": "npm run electron:build && electron-builder --linux --config electron-builder.yml",
    "electron:publish": "npm run electron:build && electron-builder --publish always"
  },
  "main": "dist-electron/main.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.81.0",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
